{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Bossnet Copilot",
  "version": "0.1.0",
  "identifier": "ro.bossnet.copilot",
  "build": {
    "frontendDist": "../src",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "",
    "beforeDevCommand": ""
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Bossnet Copilot",
        "width": 480,
        "height": 720,
        "minWidth": 380,
        "minHeight": 520,
        "resizable": true,
        "url": "index.html"
      },
      {
        "label": "overlay",
        "title": "Bossnet Copilot — Overlay",
        "width": 420,
        "height": 220,
        "resizable": true,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "url": "overlay.html",
        "visible": false,
        "contentProtected": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "msi"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "windows": {
      "wix": {
        "language": "ro-RO"
      }
    }
  }
}
